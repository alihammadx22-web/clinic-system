# Local-only browser QA. Playwright refuses non-local QA_BASE_URL values.
RECOVERA_ENV=test
API_BASE_URL=http://127.0.0.1:8001
NEXT_PUBLIC_SUPABASE_URL=https://TEST_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-test-publishable-key
STAFF_SESSION_MAX_AGE_SECONDS=43200

QA_BASE_URL=http://127.0.0.1:3100
QA_STAFF_E2E=1
QA_SUSPENDED_E2E=0
QA_NEW_PATIENT=0
QA_VISUAL_REVIEW=0

# Synthetic identities from the dedicated test Supabase project.
QA_RECEPTION_EMAIL=replace-with-test-email
QA_RECEPTION_PASSWORD=replace-with-test-password
QA_ALI_EMAIL=replace-with-test-email
QA_ALI_PASSWORD=replace-with-test-password
QA_OMAR_EMAIL=replace-with-test-email
QA_OMAR_PASSWORD=replace-with-test-password
