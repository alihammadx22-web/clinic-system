RECOVERA_ENV=staging

# Server-side FastAPI URL. It must use HTTPS. Browser API calls stay on
# /api/backend.
API_BASE_URL=https://api-staging.recovera.example

# Public values from the dedicated staging Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key

# Server-side hard staff-session lifetime (12 hours).
STAFF_SESSION_MAX_AGE_SECONDS=43200
